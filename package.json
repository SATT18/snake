{
  "name": "snake",
  "version": "2.0.0",
  "description": "Snake game for Windows (Electron + TypeScript)",
  "main": "dist/main.js",
  "author": "Andrey",
  "license": "MIT",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && esbuild src/renderer/app.ts --bundle --minify --format=iife --target=chrome128 --outfile=dist/renderer/app.js && node scripts/copy-static.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "three": "^0.170.0",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.andrey.snake",
    "productName": "Snake",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
